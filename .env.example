# Chiave Anthropic — server-side ONLY, mai nel bundle client. Usata per prezzi
# (web search), sottostanti, rating, analisi, chat e track record delle call.
ANTHROPIC_API_KEY=

# Modello usato per tutte le chiamate. Default nel codice: claude-opus-5 (il più
# capace). Su un uso quotidiano e ripetuto come questo, valuta claude-sonnet-5
# per contenere i costi — vedi README "Costi".
ANTHROPIC_MODEL=claude-opus-5

# Store dati: JSON versionati in questo stesso repo, letti/scritti via GitHub API
# in produzione (il filesystem delle funzioni serverless Vercel è effimero).
# Token fine-grained con permesso "Contents: Read and write" SOLO su questo repo.
GITHUB_TOKEN=
GITHUB_REPO=robertofolco82/finance
GITHUB_BRANCH=main

# Protegge /api/cron/refresh-prezzi da chiamate esterne. Vercel invia
# automaticamente Authorization: Bearer $CRON_SECRET quando la variabile è
# impostata — genera una stringa casuale, es. `openssl rand -hex 32`.
CRON_SECRET=

# "fs" | "github" — normalmente non serve impostarla: fs in locale (VERCEL non
# è definita), github in automatico su Vercel. Utile solo per forzare un backend
# durante debug.
# DATA_BACKEND=
